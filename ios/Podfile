# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.5'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'LifeMap' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # `pod install` cleans the .last_build_configuration marker that RN's prebuilt
    # pods use to track which slice (Debug/Release) is extracted, but leaves the
    # slice itself. A missing marker makes RN assume Debug, so a Debug build after
    # a Release build links against Release binaries and fails on debug-only
    # symbols. Writing a sentinel forces the next build to re-extract its slice.
    ['React-Core-prebuilt', 'ReactNativeDependencies'].each do |pod_name|
      pod_dir = File.join(installer.sandbox.root, pod_name)
      next unless File.directory?(pod_dir)
      File.write(File.join(pod_dir, '.last_build_configuration'), 'Invalidated')
    end

    # Xcode 27 SDKs reject deployment targets below iOS 15.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        version = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if version.nil? || Gem::Version.new(version) < Gem::Version.new('15.0')
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
        end
      end
    end
  end
end
